{
  "name": "game-factory",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "games/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p tsconfig.json",
    "check:assets": "node scripts/check-assets.ts",
    "test": "vitest run",
    "new-game": "node scripts/new-game.ts",
    "build:local": "node scripts/build-games.ts local",
    "build:site": "node scripts/build-site.ts",
    "test:smoke": "npm run build:local && playwright test e2e/smoke.spec.ts e2e/results.spec.ts e2e/dodge-drop.spec.ts e2e/dodge-drop-mobile.spec.ts e2e/crazygames-viewport.spec.ts",
    "test:rwd": "npm run build:local && npm run build:site && playwright test e2e/rwd.spec.ts",
    "test:site": "npm run build:site && playwright test e2e/site-mobile.spec.ts",
    "build:portals": "node scripts/build-portals.ts",
    "release-status": "node scripts/release-status.ts",
    "covers": "node scripts/render-covers.ts",
    "test:portals": "node scripts/build-portals.ts --smoke && playwright test e2e/portals.spec.ts",
    "store-video": "node scripts/store-video.ts",
    "publish:prep": "node scripts/publish-payload.ts",
    "mark-released": "node scripts/mark-released.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
